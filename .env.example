# WeAmaze Visionary — environment variables (names and meaning only; never commit values).
# Variables prefixed PUBLIC_ are compiled into the browser bundle and must never hold secrets.
#
# Local use: copy to .env (never committed). On Fly.io: non-secret values are already in
# fly.toml under [env] and [build.args]; values marked SECRET go in `fly secrets set NAME=value`.

# ---- Public build-time configuration ----
PUBLIC_SITE_ENV=            # development | staging | production. production on the live site (Docker default): indexable, and work not cleared for publication is left out. staging = private preview, noindex
PUBLIC_SITE_URL=            # confirmed canonical origin, e.g. https://weamazevisionary.com (B-04)
PUBLIC_ANALYTICS_PROVIDER=  # none (default) until an analytics tool is approved (B-13)

# ---- Server runtime ----
NODE_ENV=                   # production on live hosts (set by the Dockerfile and fly.toml)
HOST=                       # default 0.0.0.0 (all interfaces; required on Fly.io)
PORT=                       # default 4173 locally; 8080 in Docker and on Fly.io (fly.toml internal_port)
TRUST_PROXY=                # true behind a CDN / load balancer, including Fly.io (uses X-Forwarded-For for rate limits)
TRUST_PROXY_HOPS=1          # trusted proxies in front of the app: 1 for one load balancer, 2 for Cloudflare in front of the host's edge
FORCE_HSTS=                 # true once HTTPS is confirmed on the production domain
PRIMARY_REGION=             # Fly.io only (set in fly.toml, "jnb"): the one region that stores data. Leave empty elsewhere.
# On a Hostinger VPS, use deploy/hostinger.env.example instead (docs/14_DEPLOY_HOSTINGER.md).
# FLY_REGION and FLY_PROCESS_GROUP are set by Fly.io itself; never set them by hand (docs/13_GLOBAL_ARCHITECTURE.md).

# ---- Lead storage, anti-abuse ----
LEAD_STORE_DIR=             # persistent, backed-up directory for leads/outbox (default ./data; /data on the Fly.io volume)
RATE_LIMIT_MAX=             # submissions per window per client (default 5)
RATE_LIMIT_WINDOW_SECONDS=  # default 600
MIN_FORM_SECONDS=           # minimum time between form start and submit (default 3)

# ---- CRM (B-09) ----
CRM_PROVIDER=               # none | webhook
CRM_WEBHOOK_URL_PROJECTS=   # SECRET if the URL contains a token. Receives client project briefs and call requests
CRM_WEBHOOK_URL_PARTNERS=   # SECRET if the URL contains a token. Receives partnership enquiries (separate pipeline)
CRM_WEBHOOK_URL_GENERAL=    # optional; falls back to the projects URL
CRM_WEBHOOK_SECRET=         # SECRET. HMAC key (≥16 chars) used to sign X-WV-Signature

# ---- Transactional email (B-10) ----
EMAIL_PROVIDER=             # none | log (development only) | resend
RESEND_API_KEY=             # SECRET. fly secrets set RESEND_API_KEY=re_...
EMAIL_FROM=                 # verified sender, e.g. "WeAmaze Visionary <hello@weamazevisionary.com>"
EMAIL_REPLY_TO=             # monitored reply-to address
OPERATOR_NOTIFICATION_EMAIL=weamazevisionary@gmail.com # receives Contact requests in full (reply goes to the sender), lead alerts and failed deliveries

# ---- Scheduling (B-08) ----
BOOKING_PROVIDER=           # none (call-request fallback) | mock (development/test only; refused in production)
BOOKING_MOCK_HOST_TZ=       # IANA zone for the development mock's working hours
BOOKING_WEBHOOK_SECRET=     # SECRET. HMAC key for provider webhooks (≥16 chars)
