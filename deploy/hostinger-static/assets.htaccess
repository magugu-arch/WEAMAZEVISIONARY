# Scripts, styles and fonts here have content-hashed names: cache them for a year.
# The main .htaccess must not name any file type found in this folder: on LiteSpeed its
# per-type rules win over this file (found on the live site, 22 November 2026).
<IfModule mod_headers.c>
  <FilesMatch ".">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
