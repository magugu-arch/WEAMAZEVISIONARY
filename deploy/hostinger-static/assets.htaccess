# Scripts, styles and fonts here have content-hashed names: cache them for a year.
# Written per file so it also replaces the 7-day rule the main .htaccess gives font files.
<IfModule mod_headers.c>
  <FilesMatch ".">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
