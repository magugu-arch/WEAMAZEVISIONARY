# Settings for the Hostinger VPS. Copy to ".env" in the project folder on the server:
#   cp deploy/hostinger.env.example .env && chmod 600 .env
# Never commit .env: it holds secrets. Every setting is explained in .env.example.

# Your domain, without https:// or www (Caddy gets certificates for it and for www.)
SITE_DOMAIN=weamazevisionary.com

# 1 with Caddy only. 2 if Cloudflare proxies the domain (and see deploy/Caddyfile).
TRUST_PROXY_HOPS=1

OPERATOR_NOTIFICATION_EMAIL=weamazevisionary@gmail.com

# Email notifications (recommended). Needs a Resend account with your domain verified.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM=WeAmaze Visionary <hello@weamazevisionary.com>
# EMAIL_REPLY_TO=weamazevisionary@gmail.com

# CRM (optional): every enquiry is also sent to your CRM, signed with the secret.
# CRM_PROVIDER=webhook
# CRM_WEBHOOK_URL_PROJECTS=
# CRM_WEBHOOK_URL_PARTNERS=
# CRM_WEBHOOK_URL_GENERAL=
# CRM_WEBHOOK_SECRET=
